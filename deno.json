{
  "name": "@fcc/js-challenges",
  "version": "0.1.0",
  "exports": "./mod.js",
  "tasks": {
    "test": "deno test --allow-read",
    "test:watch": "deno test --allow-read --watch",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "test": {
    "include": ["tests/"]
  }
}
